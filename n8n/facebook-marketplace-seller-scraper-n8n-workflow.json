      "parameters": {
        "jsCode": "// Normalize fields, parse numeric metrics, and score items for AI enrichment\nconst config = $('Set Search Parameters').first().json;\nconst threshold = Number(config.minTotalListings !== undefined ? config.minTotalListings : 3);\nconst keywordFilter = String(config.priorityKeyword || '').trim().toLowerCase();\nconst primaryKeys = [\"seed_item_id\", \"seed_item_url\", \"seller_id\", \"seller_name\", \"inferred_seller_tier\", \"is_undisclosed_dealer\"];\n\nreturn $input.all().map((item) => {\n  const raw = item.json || {};\n  const cleaned = { ...raw };\n\n  for (const k of primaryKeys) {\n    if (typeof cleaned[k] === 'string') {\n      cleaned[k] = cleaned[k].replace(/\\s+/g, ' ').trim();\n    }\n  }\n\n  const recordId = String(cleaned.id || cleaned.url || '');\n  const titleText = String(cleaned.seller_name || recordId).slice(0, 180);\n  const itemUrl = String(cleaned.marketplace_profile_url || cleaned.seed_item_url || '');\n  const rawMetric = cleaned.total_listings_count || cleaned.active_listings_count || 0;\n  const numericValue = Number(String(rawMetric).replace(/[^0-9.-]/g, '')) || 0;\n\n  let priorityScore = 50;\n  let isHighPriority = false;\n\n  if (cleaned.is_undisclosed_dealer === true || cleaned.inferred_seller_tier === 'HIGH_VOLUME_DEALER' || numericValue >= threshold) {\n    priorityScore = cleaned.is_undisclosed_dealer === true ? 95 : 85;\n    isHighPriority = true;\n  }\n\n  if (keywordFilter && titleText.toLowerCase().includes(keywordFilter)) {\n    priorityScore = Math.min(100, priorityScore + 20);\n    isHighPriority = true;\n  }\n\n  return {\n    json: {\n      ...cleaned,\n      recordId,\n      titleText,\n      itemUrl,\n      numericValue,\n      priorityScore,\n      isHighPriority,\n      alertSummary: titleText + ' (Metric: ' + numericValue + ' | Score: ' + priorityScore + '/100)',\n      scrapedAt: new Date().toISOString(),\n    },\n  };\n});"
      },
